{
  "name": "legal-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 8080",
    "lint": "eslint . && node scripts/check-tokens.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run --typecheck",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "gen:api": "node scripts/gen-api.mjs",
    "tokens:contrast": "node scripts/check-contrast.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "format": "prettier --write .",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm tokens:contrast && pnpm build && pnpm check:bundle"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@radix-ui/react-visually-hidden": "^1.2.13",
    "@tanstack/react-query": "^5",
    "@tanstack/react-virtual": "^3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff-match-patch": "^1.0.5",
    "lucide-react": "^1.64.0",
    "openapi-fetch": "^0.17.0",
    "pdfjs-dist": "4.8.69",
    "react": "^18.3",
    "react-dom": "^18.3",
    "react-pdf": "^9.2.1",
    "react-router-dom": "^6",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4",
    "@tanstack/eslint-plugin-query": "^5.105.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^26.6.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4",
    "@vitest/coverage-v8": "^3",
    "axe-core": "^4.14.0",
    "eslint": "^9",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "msw": "^2",
    "openapi-typescript": "^7",
    "prettier": "^3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "~5.8",
    "typescript-eslint": "^8.72.1",
    "vite": "^6",
    "vitest": "^3",
    "vitest-axe": "^0.1.0"
  }
}
